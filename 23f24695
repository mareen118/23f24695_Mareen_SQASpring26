#include <iostream>
using namespace std;

int main()
{
    int sector;
    int demandIncrease;

    cout << "Enter sector (1=IT, 2=Healthcare, 3=Engineering): ";
    cin >> sector;

    cout << "Enter demand increase percentage: ";
    cin >> demandIncrease;

    switch(sector)
    {
        case 1:
            cout << "IT Sector" << endl;
            break;

        case 2:
            cout << "Healthcare Sector" << endl;
            break;

        case 3:
            cout << "Engineering Sector" << endl;
            break;

        default:
            cout << "Invalid Sector" << endl;
    }
if(demandIncrease > 25)
    {
        cout << "High Demand Alert" << endl;
    }
    else
    {
        cout << "Normal Demand" << endl;
    }

    return 0;
}
